class clssaln_employeeDataSource extends clsDBConnection1 {  //saln_employeeDataSource Class @2-CB8B3742

//DataSource Variables @2-B3A35879
    var $Parent = "";
    var $CCSEvents = "";
    var $CCSEventResult;
    var $ErrorBlock;
    var $CmdExecution;

    var $wp;


    // Datasource fields
    var $EmployeeIDNo;
    var $Surname;
    var $FirstName;
    var $YearID;
    var $ScannedSALN;
    var $Sum_YearID2;
    var $Sum_YearID1;
    var $Sum_YearID;
    var $TotalSum_YearID;
//End DataSource Variables

//DataSourceClass_Initialize Event @2-A7563BEB
    function clssaln_employeeDataSource(& $Parent)
    {
        $this->Parent = & $Parent;
        $this->ErrorBlock = "Report saln_employee";
        $this->Initialize();
        $this->EmployeeIDNo = new clsField("EmployeeIDNo", ccsText, "");
        
        $this->Surname = new clsField("Surname", ccsText, "");
        
        $this->FirstName = new clsField("FirstName", ccsText, "");
        
        $this->YearID = new clsField("YearID", ccsInteger, "");
        
        $this->ScannedSALN = new clsField("ScannedSALN", ccsText, "");
        
        $this->Sum_YearID2 = new clsField("Sum_YearID2", ccsInteger, "");
        
        $this->Sum_YearID1 = new clsField("Sum_YearID1", ccsInteger, "");
        
        $this->Sum_YearID = new clsField("Sum_YearID", ccsInteger, "");
        
        $this->TotalSum_YearID = new clsField("TotalSum_YearID", ccsInteger, "");
        

    }
//End DataSourceClass_Initialize Event

//SetOrder Method @2-32EDBF8E
    function SetOrder($SorterName, $SorterDirection)
    {
        $this->Order = "";
        $this->Order = CCGetOrder($this->Order, $SorterName, $SorterDirection, 
            array("Sorter_YearID" => array("YearID", ""), 
            "Sorter_ScannedSALN" => array("ScannedSALN", "")));
    }
//End SetOrder Method

//Prepare Method @2-167C80C8
    function Prepare()
    {
        global $CCSLocales;
        global $DefaultDateFormat;
        $this->wp = new clsSQLParameters($this->ErrorBlock);
        $this->wp->AddParameter("1", "urls_EmployeeIDNo", ccsText, "", "", $this->Parameters["urls_EmployeeIDNo"], "", false);
        $this->wp->AddParameter("2", "urls_Surname", ccsText, "", "", $this->Parameters["urls_Surname"], "", false);
        $this->wp->AddParameter("3", "urls_FirstName", ccsText, "", "", $this->Parameters["urls_FirstName"], "", false);
        $this->wp->Criterion[1] = $this->wp->Operation(opContains, "EmployeeIDNo", $this->wp->GetDBValue("1"), $this->ToSQL($this->wp->GetDBValue("1"), ccsText),false);
        $this->wp->Criterion[2] = $this->wp->Operation(opContains, "Surname", $this->wp->GetDBValue("2"), $this->ToSQL($this->wp->GetDBValue("2"), ccsText),false);
        $this->wp->Criterion[3] = $this->wp->Operation(opContains, "FirstName", $this->wp->GetDBValue("3"), $this->ToSQL($this->wp->GetDBValue("3"), ccsText),false);
        $this->Where = $this->wp->opAND(
             false, $this->wp->opAND(
             false, 
             $this->wp->Criterion[1], 
             $this->wp->Criterion[2]), 
             $this->wp->Criterion[3]);
    }
//End Prepare Method

//Open Method @2-0C5B10CA
    function Open()
    {
        $this->CCSEventResult = CCGetEvent($this->CCSEvents, "BeforeBuildSelect", $this->Parent);
        $this->SQL = "SELECT EmployeeIDNo, Surname, FirstName, ScannedSALN \n\n" .
        "FROM saln INNER JOIN employee ON\n\n" .
        "saln.EmployeeID = employee.EmployeeID {SQL_Where} {SQL_OrderBy}";
        $this->CCSEventResult = CCGetEvent($this->CCSEvents, "BeforeExecuteSelect", $this->Parent);
        $this->query(CCBuildSQL($this->SQL, $this->Where, "employee.EmployeeIDNo asc,employee.Surname asc,employee.FirstName asc" .  ($this->Order ? ", " . $this->Order: "")));
        $this->CCSEventResult = CCGetEvent($this->CCSEvents, "AfterExecuteSelect", $this->Parent);
    }
//End Open Method

//SetValues Method @2-724BC7FC
    function SetValues()
    {
        $this->EmployeeIDNo->SetDBValue($this->f("EmployeeIDNo"));
        $this->Surname->SetDBValue($this->f("Surname"));
        $this->FirstName->SetDBValue($this->f("FirstName"));
        $this->YearID->SetDBValue(trim($this->f("YearID")));
        $this->ScannedSALN->SetDBValue($this->f("ScannedSALN"));
        $this->Sum_YearID2->SetDBValue(trim($this->f("YearID")));
        $this->Sum_YearID1->SetDBValue(trim($this->f("YearID")));
        $this->Sum_YearID->SetDBValue(trim($this->f("YearID")));
        $this->TotalSum_YearID->SetDBValue(trim($this->f("YearID")));
    }
//End SetValues Method

} //End saln_employeeDataSource Class @2-FCB6E20C

