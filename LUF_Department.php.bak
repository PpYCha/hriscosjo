        $this->Sorter_MiddleName = & new clsSorter($this->ComponentName, "Sorter_MiddleName", $FileName, $this);
        $this->Sorter_MobileNo = & new clsSorter($this->ComponentName, "Sorter_MobileNo", $FileName, $this);
        $this->Sorter_EmailAdd = & new clsSorter($this->ComponentName, "Sorter_EmailAdd", $FileName, $this);
        $this->Sorter_Position = & new clsSorter($this->ComponentName, "Sorter_Position", $FileName, $this);
        $this->Navigator = & new clsNavigator($this->ComponentName, "Navigator", $FileName, 10, tpCentered, $this);
