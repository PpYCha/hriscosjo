$CCSEventResult = "";

$FileName = FileName;
$Redirect = "";
$TemplateFileName = "LUF_Department.html";
$BlockToParse = "main";
$TemplateEncoding = "CP1252";
$ContentType = "text/html";
$PathToRoot = "./";
$Charset = $Charset ? $Charset : "windows-1252";
