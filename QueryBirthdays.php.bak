    function SetOrder($SorterName, $SorterDirection)
    {
        $this->Order = "Surname";
        $this->Order = CCGetOrder($this->Order, $SorterName, $SorterDirection, 
            array("Sorter_EmployeeIDNo" => array("EmployeeIDNo", ""), 
            "Sorter_Surname" => array("Surname", ""), 
            "Sorter_FirstName" => array("FirstName", ""), 
            "Sorter_MiddleName" => array("MiddleName", ""), 
            "Sorter_BirthMonth" => array("BirthMonth", ""), 
            "Sorter_BirthDay" => array("BirthDay", ""), 
