        $this->SalaryGrade = new clsField("SalaryGrade", ccsText, "");
        
        $this->StepIncrement = new clsField("StepIncrement", ccsText, "");
        
        $this->MonthlySalary = new clsField("MonthlySalary", ccsSingle, "");
        
        $this->CompRetireMonth = new clsField("CompRetireMonth", ccsText, "");
        
        $this->StatApp = new clsField("StatApp", ccsText, "");
        
        $this->CompRetireDay = new clsField("CompRetireDay", ccsText, "");
        
        $this->CompRetireYear = new clsField("CompRetireYear", ccsText, "");
        
        $this->ReportLabel1 = new clsField("ReportLabel1", ccsText, "");
        
        $this->ReportLabel2 = new clsField("ReportLabel2", ccsText, "");
        
        $this->ReportLabel3 = new clsField("ReportLabel3", ccsText, "");
        
        $this->ReportLabel4 = new clsField("ReportLabel4", ccsText, "");
        

    }
//End DataSourceClass_Initialize Event

//SetOrder Method @2-D7E6D9C2
    function SetOrder($SorterName, $SorterDirection)
    {
        $this->Order = "departmentoffice.OfficeAcronym, employee.Surname";
        $this->Order = CCGetOrder($this->Order, $SorterName, $SorterDirection, 
            "");
    }
//End SetOrder Method

//Prepare Method @2-5E8DC79D
    function Prepare()
    {
        global $CCSLocales;
        global $DefaultDateFormat;
        $this->wp = new clsSQLParameters($this->ErrorBlock);
        $this->wp->AddParameter("1", "urls_employee_OfficeID", ccsInteger, "", "", $this->Parameters["urls_employee_OfficeID"], "", false);
        $this->wp->AddParameter("2", "urls_CompRetireMonth", ccsText, "", "", $this->Parameters["urls_CompRetireMonth"], "", false);
        $this->wp->AddParameter("3", "urls_CompRetireDay", ccsText, "", "", $this->Parameters["urls_CompRetireDay"], "", false);
        $this->wp->AddParameter("4", "urls_CompRetireYear", ccsText, "", "", $this->Parameters["urls_CompRetireYear"], "", false);
        $this->wp->AddParameter("5", "urlemployee_StatAppID1", ccsInteger, "", "", $this->Parameters["urlemployee_StatAppID1"], "", false);
        $this->wp->AddParameter("6", "urlemployee_ModeSeparatnID", ccsInteger, "", "", $this->Parameters["urlemployee_ModeSeparatnID"], "", false);
        $this->wp->AddParameter("7", "urlSeparationYear", ccsText, "", "", $this->Parameters["urlSeparationYear"], "", false);
        $this->wp->Criterion[1] = $this->wp->Operation(opEqual, "employee.OfficeID", $this->wp->GetDBValue("1"), $this->ToSQL($this->wp->GetDBValue("1"), ccsInteger),false);
        $this->wp->Criterion[2] = $this->wp->Operation(opEqual, "employee.CompRetireMonth", $this->wp->GetDBValue("2"), $this->ToSQL($this->wp->GetDBValue("2"), ccsText),false);
        $this->wp->Criterion[3] = $this->wp->Operation(opEqual, "employee.CompRetireDay", $this->wp->GetDBValue("3"), $this->ToSQL($this->wp->GetDBValue("3"), ccsText),false);
        $this->wp->Criterion[4] = $this->wp->Operation(opEqual, "employee.CompRetireYear", $this->wp->GetDBValue("4"), $this->ToSQL($this->wp->GetDBValue("4"), ccsText),false);
        $this->wp->Criterion[5] = $this->wp->Operation(opGreaterThan, "employee.StatAppID", $this->wp->GetDBValue("5"), $this->ToSQL($this->wp->GetDBValue("5"), ccsInteger),false);
        $this->wp->Criterion[6] = $this->wp->Operation(opEqual, "employee.ModeSeparatnID", $this->wp->GetDBValue("6"), $this->ToSQL($this->wp->GetDBValue("6"), ccsInteger),false);
        $this->wp->Criterion[7] = $this->wp->Operation(opEqual, "employee.SeparationYear", $this->wp->GetDBValue("7"), $this->ToSQL($this->wp->GetDBValue("7"), ccsText),false);
        $this->Where = $this->wp->opAND(
             false, $this->wp->opAND(
             false, $this->wp->opAND(
             false, $this->wp->opAND(
             false, $this->wp->opAND(
             false, $this->wp->opAND(
             false, 
             $this->wp->Criterion[1], 
             $this->wp->Criterion[2]), 
             $this->wp->Criterion[3]), 
             $this->wp->Criterion[4]), 
             $this->wp->Criterion[5]), 
             $this->wp->Criterion[6]), 
             $this->wp->Criterion[7]);
    }
//End Prepare Method

//Open Method @2-F630401D
    function Open()
    {
        $this->CCSEventResult = CCGetEvent($this->CCSEvents, "BeforeBuildSelect", $this->Parent);
        $this->SQL = "SELECT Surname, FirstName, MiddleName, SalaryGrade, StepIncrement, MonthlySalary, employee.StatAppID AS employee_StatAppID, employee.OfficeID AS employee_OfficeID,\n\n" .
        "CompRetireMonth, CompRetireDay, CompRetireYear, OfficeAcronym, employee.Position AS employee_Position, ItemNo, lut_statofappt2.*,\n\n" .
        "employee.ModeSeparatnID AS employee_ModeSeparatnID, lut_modeseparatn.*, SeparationMonth, SeparationDay, SeparationYear \n\n" .
        "FROM ((employee LEFT JOIN departmentoffice ON\n\n" .
        "employee.OfficeID = departmentoffice.OfficeID) LEFT JOIN lut_statofappt2 ON\n\n" .
        "employee.StatAppID = lut_statofappt2.StatAppID) LEFT JOIN lut_modeseparatn ON\n\n" .
        "employee.ModeSeparatnID = lut_modeseparatn.ModeSeparatnID {SQL_Where} {SQL_OrderBy}";
        $this->CCSEventResult = CCGetEvent($this->CCSEvents, "BeforeExecuteSelect", $this->Parent);
        $this->query(CCBuildSQL($this->SQL, $this->Where, $this->Order));
        $this->CCSEventResult = CCGetEvent($this->CCSEvents, "AfterExecuteSelect", $this->Parent);
    }
//End Open Method

//SetValues Method @2-A5AC8049
    function SetValues()
    {
        $this->OfficeAcronym->SetDBValue($this->f("OfficeAcronym"));
        $this->Surname->SetDBValue($this->f("Surname"));
        $this->FirstName->SetDBValue($this->f("FirstName"));
        $this->MiddleName->SetDBValue($this->f("MiddleName"));
        $this->employee_Position->SetDBValue($this->f("employee_Position"));
        $this->ItemNo->SetDBValue($this->f("ItemNo"));
        $this->SalaryGrade->SetDBValue($this->f("SalaryGrade"));
        $this->StepIncrement->SetDBValue($this->f("StepIncrement"));
        $this->MonthlySalary->SetDBValue(trim($this->f("MonthlySalary")));
        $this->CompRetireMonth->SetDBValue($this->f("CompRetireMonth"));
        $this->StatApp->SetDBValue($this->f("StatApp"));
        $this->CompRetireDay->SetDBValue($this->f("CompRetireDay"));
        $this->CompRetireYear->SetDBValue($this->f("CompRetireYear"));
        $this->ReportLabel1->SetDBValue($this->f("ModeSeparatn"));
        $this->ReportLabel2->SetDBValue($this->f("SeparationMonth"));
        $this->ReportLabel3->SetDBValue($this->f("SeparationDay"));
        $this->ReportLabel4->SetDBValue($this->f("SeparationYear"));
    }
//End SetValues Method

