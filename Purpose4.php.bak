        $this->InsertFields["CertYear"] = array("Name" => "CertYear", "Value" => "", "DataType" => ccsText, "OmitIfEmpty" => 1);
        $this->UpdateFields["SecRecPurposeID"] = array("Name" => "SecRecPurposeID", "Value" => "", "DataType" => ccsInteger, "OmitIfEmpty" => 1);
