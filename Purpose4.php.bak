    function SetValues()
    {
        $this->SecRecPurposeID->SetDBValue(trim($this->f("SecRecPurposeID")));
        $this->CertDay->SetDBValue($this->f("CertDay"));
        $this->CertMonth->SetDBValue($this->f("CertMonth"));
        $this->CertYear->SetDBValue($this->f("CertYear"));
