        $this->CmdExecution = true;
        $this->CCSEventResult = CCGetEvent($this->CCSEvents, "BeforeBuildInsert", $this->Parent);
        $this->InsertFields["SecRecPurposeID"]["Value"] = $this->ListBox8->GetDBValue(true);
        $this->InsertFields["CertMonth"]["Value"] = $this->ListBox18->GetDBValue(true);
        $this->InsertFields["CertYear"]["Value"] = $this->ListBox20->GetDBValue(true);
        $this->InsertFields["CertDay"]["Value"] = $this->ListBox19->GetDBValue(true);
        $this->SQL = CCBuildInsert("employee", $this->InsertFields, $this);
        $this->CCSEventResult = CCGetEvent($this->CCSEvents, "BeforeExecuteInsert", $this->Parent);
        if($this->Errors->Count() == 0 && $this->CmdExecution) {
            $this->query($this->SQL);
            $this->CCSEventResult = CCGetEvent($this->CCSEvents, "AfterExecuteInsert", $this->Parent);
        }
