{
    $CCSEventResult = CCGetEvent($CCSEvents, "BeforeUnload", $MainPage);
    $DBConnection1->close();
    header("Location: " . $Redirect);
    unset($employee_recognition);
    unset($Tpl);
    exit;
}
//End Go to destination page

//Show Page @1-538E8B4E
