//DataSourceClass_Initialize Event @2-F3AF761C
    function clsemployee_ipcr_lut_ratingDataSource(& $Parent)
    {
        $this->Parent = & $Parent;
        $this->ErrorBlock = "Report employee_ipcr_lut_rating";
        $this->Initialize();
        $this->ReportLabel2 = new clsField("ReportLabel2", ccsText, "");
        
        $this->AccompSemester = new clsField("AccompSemester", ccsText, "");
        
        $this->NumericRating = new clsField("NumericRating", ccsSingle, "");
        
        $this->Rating = new clsField("Rating", ccsText, "");
        
        $this->TargetYear = new clsField("TargetYear", ccsText, "");
        
        $this->AnsID = new clsField("AnsID", ccsInteger, "");
        
        $this->Remarks = new clsField("Remarks", ccsText, "");
        
        $this->ScannedIPCR = new clsField("ScannedIPCR", ccsText, "");
        
        $this->MiddleName = new clsField("MiddleName", ccsText, "");
        
        $this->ReportLabel1 = new clsField("ReportLabel1", ccsText, "");
        
        $this->Surname = new clsField("Surname", ccsText, "");
        
        $this->FirstName = new clsField("FirstName", ccsText, "");
        
        $this->AccompYear = new clsField("AccompYear", ccsText, "");
        
        $this->AccompYear2 = new clsField("AccompYear2", ccsText, "");
        
        $this->AccompYear3 = new clsField("AccompYear3", ccsText, "");
        

    }
//End DataSourceClass_Initialize Event

//SetOrder Method @2-98D3FFA5
    function SetOrder($SorterName, $SorterDirection)
    {
        $this->Order = "AccompYear desc";
        $this->Order = CCGetOrder($this->Order, $SorterName, $SorterDirection, 
            "");
    }
//End SetOrder Method

//Prepare Method @2-B547B724
    function Prepare()
    {
        global $CCSLocales;
        global $DefaultDateFormat;
        $this->wp = new clsSQLParameters($this->ErrorBlock);
        $this->wp->AddParameter("1", "urlEmployeeID", ccsInteger, "", "", $this->Parameters["urlEmployeeID"], "", false);
        $this->wp->Criterion[1] = $this->wp->Operation(opEqual, "employee.EmployeeID", $this->wp->GetDBValue("1"), $this->ToSQL($this->wp->GetDBValue("1"), ccsInteger),false);
        $this->Where = 
             $this->wp->Criterion[1];
    }
//End Prepare Method

//Open Method @2-9FB6E25B
    function Open()
    {
        $this->CCSEventResult = CCGetEvent($this->CCSEvents, "BeforeBuildSelect", $this->Parent);
        $this->SQL = "SELECT EmployeeIDNo, ipcr.*, Surname, FirstName, MiddleName, NameExtension, lut_rating.*, EmpPicture \n\n" .
        "FROM (ipcr INNER JOIN employee ON\n\n" .
        "ipcr.EmployeeID = employee.EmployeeID) INNER JOIN lut_rating ON\n\n" .
        "ipcr.RatingID = lut_rating.RatingID {SQL_Where} {SQL_OrderBy}";
        $this->CCSEventResult = CCGetEvent($this->CCSEvents, "BeforeExecuteSelect", $this->Parent);
        $this->query(CCBuildSQL($this->SQL, $this->Where, $this->Order));
        $this->CCSEventResult = CCGetEvent($this->CCSEvents, "AfterExecuteSelect", $this->Parent);
    }
//End Open Method

//SetValues Method @2-3297A04A
    function SetValues()
    {
        $this->ReportLabel2->SetDBValue($this->f("EmpPicture"));
        $this->AccompSemester->SetDBValue($this->f("AccompSemester"));
        $this->NumericRating->SetDBValue(trim($this->f("NumericRating")));
        $this->Rating->SetDBValue($this->f("Rating"));
        $this->TargetYear->SetDBValue($this->f("TargetYear"));
        $this->AnsID->SetDBValue(trim($this->f("AnsID")));
        $this->Remarks->SetDBValue($this->f("Remarks"));
        $this->ScannedIPCR->SetDBValue($this->f("ScannedIPCR"));
        $this->MiddleName->SetDBValue($this->f("MiddleName"));
        $this->ReportLabel1->SetDBValue($this->f("TargetSemester"));
        $this->Surname->SetDBValue($this->f("Surname"));
        $this->FirstName->SetDBValue($this->f("FirstName"));
        $this->AccompYear->SetDBValue($this->f("AccompYear"));
        $this->AccompYear2->SetDBValue($this->f("NameExtension"));
        $this->AccompYear3->SetDBValue($this->f("EmployeeIDNo"));
    }
//End SetValues Method

} //End employee_ipcr_lut_ratingDataSource Class @2-FCB6E20C

