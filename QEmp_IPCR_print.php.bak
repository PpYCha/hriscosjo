    var $PageNumber;
    var $RowNumber;
    var $Parent;

    function clsReportGroupemployee_ipcr_lut_rating(& $parent) {
        $this->Parent = & $parent;
        $this->Attributes = $this->Parent->Attributes->GetAsArray();
    }
    function SetControls($PrevGroup = "") {
        $this->ReportLabel2 = $this->Parent->ReportLabel2->Value;
        $this->AccompSemester = $this->Parent->AccompSemester->Value;
        $this->NumericRating = $this->Parent->NumericRating->Value;
        $this->Rating = $this->Parent->Rating->Value;
        $this->TargetYear = $this->Parent->TargetYear->Value;
        $this->AnsID = $this->Parent->AnsID->Value;
        $this->Remarks = $this->Parent->Remarks->Value;
        $this->ScannedIPCR = $this->Parent->ScannedIPCR->Value;
        $this->MiddleName = $this->Parent->MiddleName->Value;
        $this->ReportLabel1 = $this->Parent->ReportLabel1->Value;
        $this->Surname = $this->Parent->Surname->Value;
        $this->FirstName = $this->Parent->FirstName->Value;
        $this->AccompYear = $this->Parent->AccompYear->Value;
        $this->AccompYear2 = $this->Parent->AccompYear2->Value;
        $this->AccompYear3 = $this->Parent->AccompYear3->Value;
    }

    function SetTotalControls($mode = "", $PrevGroup = "") {
        $this->Report_TotalRecords = $this->Parent->Report_TotalRecords->GetTotalValue($mode);
        $this->Report_Row_Number = $this->Parent->Report_Row_Number->GetTotalValue($mode);
        $this->_ScannedIPCRPage = $this->Parent->ScannedIPCR->Page;
        $this->_ScannedIPCRParameters = $this->Parent->ScannedIPCR->Parameters;
        $this->_Report_TotalRecordsAttributes = $this->Parent->Report_TotalRecords->Attributes->GetAsArray();
        $this->_ReportLabel2Attributes = $this->Parent->ReportLabel2->Attributes->GetAsArray();
        $this->_Report_Row_NumberAttributes = $this->Parent->Report_Row_Number->Attributes->GetAsArray();
        $this->_AccompSemesterAttributes = $this->Parent->AccompSemester->Attributes->GetAsArray();
        $this->_NumericRatingAttributes = $this->Parent->NumericRating->Attributes->GetAsArray();
        $this->_RatingAttributes = $this->Parent->Rating->Attributes->GetAsArray();
        $this->_TargetYearAttributes = $this->Parent->TargetYear->Attributes->GetAsArray();
        $this->_AnsIDAttributes = $this->Parent->AnsID->Attributes->GetAsArray();
        $this->_RemarksAttributes = $this->Parent->Remarks->Attributes->GetAsArray();
        $this->_ScannedIPCRAttributes = $this->Parent->ScannedIPCR->Attributes->GetAsArray();
        $this->_MiddleNameAttributes = $this->Parent->MiddleName->Attributes->GetAsArray();
        $this->_ReportLabel1Attributes = $this->Parent->ReportLabel1->Attributes->GetAsArray();
        $this->_SurnameAttributes = $this->Parent->Surname->Attributes->GetAsArray();
        $this->_FirstNameAttributes = $this->Parent->FirstName->Attributes->GetAsArray();
        $this->_AccompYearAttributes = $this->Parent->AccompYear->Attributes->GetAsArray();
        $this->_AccompYear2Attributes = $this->Parent->AccompYear2->Attributes->GetAsArray();
        $this->_AccompYear3Attributes = $this->Parent->AccompYear3->Attributes->GetAsArray();
        $this->_NavigatorAttributes = $this->Parent->Navigator->Attributes->GetAsArray();
        $this->_Report_CurrentDateAttributes = $this->Parent->Report_CurrentDate->Attributes->GetAsArray();
    }
    function SyncWithHeader(& $Header) {
        $Header->Report_TotalRecords = $this->Report_TotalRecords;
        $Header->_Report_TotalRecordsAttributes = $this->_Report_TotalRecordsAttributes;
        $Header->Report_Row_Number = $this->Report_Row_Number;
        $Header->_Report_Row_NumberAttributes = $this->_Report_Row_NumberAttributes;
        $this->ReportLabel2 = $Header->ReportLabel2;
        $Header->_ReportLabel2Attributes = $this->_ReportLabel2Attributes;
        $this->Parent->ReportLabel2->Value = $Header->ReportLabel2;
        $this->Parent->ReportLabel2->Attributes->RestoreFromArray($Header->_ReportLabel2Attributes);
        $this->AccompSemester = $Header->AccompSemester;
        $Header->_AccompSemesterAttributes = $this->_AccompSemesterAttributes;
        $this->Parent->AccompSemester->Value = $Header->AccompSemester;
        $this->Parent->AccompSemester->Attributes->RestoreFromArray($Header->_AccompSemesterAttributes);
        $this->NumericRating = $Header->NumericRating;
        $Header->_NumericRatingAttributes = $this->_NumericRatingAttributes;
        $this->Parent->NumericRating->Value = $Header->NumericRating;
        $this->Parent->NumericRating->Attributes->RestoreFromArray($Header->_NumericRatingAttributes);
        $this->Rating = $Header->Rating;
        $Header->_RatingAttributes = $this->_RatingAttributes;
        $this->Parent->Rating->Value = $Header->Rating;
        $this->Parent->Rating->Attributes->RestoreFromArray($Header->_RatingAttributes);
        $this->TargetYear = $Header->TargetYear;
        $Header->_TargetYearAttributes = $this->_TargetYearAttributes;
        $this->Parent->TargetYear->Value = $Header->TargetYear;
        $this->Parent->TargetYear->Attributes->RestoreFromArray($Header->_TargetYearAttributes);
        $this->AnsID = $Header->AnsID;
        $Header->_AnsIDAttributes = $this->_AnsIDAttributes;
        $this->Parent->AnsID->Value = $Header->AnsID;
        $this->Parent->AnsID->Attributes->RestoreFromArray($Header->_AnsIDAttributes);
        $this->Remarks = $Header->Remarks;
        $Header->_RemarksAttributes = $this->_RemarksAttributes;
        $this->Parent->Remarks->Value = $Header->Remarks;
        $this->Parent->Remarks->Attributes->RestoreFromArray($Header->_RemarksAttributes);
        $this->ScannedIPCR = $Header->ScannedIPCR;
        $this->_ScannedIPCRPage = $Header->_ScannedIPCRPage;
        $this->_ScannedIPCRParameters = $Header->_ScannedIPCRParameters;
        $Header->_ScannedIPCRAttributes = $this->_ScannedIPCRAttributes;
        $this->Parent->ScannedIPCR->Value = $Header->ScannedIPCR;
        $this->Parent->ScannedIPCR->Attributes->RestoreFromArray($Header->_ScannedIPCRAttributes);
        $this->MiddleName = $Header->MiddleName;
        $Header->_MiddleNameAttributes = $this->_MiddleNameAttributes;
        $this->Parent->MiddleName->Value = $Header->MiddleName;
        $this->Parent->MiddleName->Attributes->RestoreFromArray($Header->_MiddleNameAttributes);
        $this->ReportLabel1 = $Header->ReportLabel1;
        $Header->_ReportLabel1Attributes = $this->_ReportLabel1Attributes;
        $this->Parent->ReportLabel1->Value = $Header->ReportLabel1;
        $this->Parent->ReportLabel1->Attributes->RestoreFromArray($Header->_ReportLabel1Attributes);
        $this->Surname = $Header->Surname;
        $Header->_SurnameAttributes = $this->_SurnameAttributes;
        $this->Parent->Surname->Value = $Header->Surname;
        $this->Parent->Surname->Attributes->RestoreFromArray($Header->_SurnameAttributes);
        $this->FirstName = $Header->FirstName;
        $Header->_FirstNameAttributes = $this->_FirstNameAttributes;
        $this->Parent->FirstName->Value = $Header->FirstName;
        $this->Parent->FirstName->Attributes->RestoreFromArray($Header->_FirstNameAttributes);
        $this->AccompYear = $Header->AccompYear;
        $Header->_AccompYearAttributes = $this->_AccompYearAttributes;
        $this->Parent->AccompYear->Value = $Header->AccompYear;
        $this->Parent->AccompYear->Attributes->RestoreFromArray($Header->_AccompYearAttributes);
        $this->AccompYear2 = $Header->AccompYear2;
        $Header->_AccompYear2Attributes = $this->_AccompYear2Attributes;
        $this->Parent->AccompYear2->Value = $Header->AccompYear2;
        $this->Parent->AccompYear2->Attributes->RestoreFromArray($Header->_AccompYear2Attributes);
        $this->AccompYear3 = $Header->AccompYear3;
