//BindEvents Method @1-F66F86F5
function BindEvents()
{
    global $employee_saln_lut_year;
    $employee_saln_lut_year->Navigator->CCSEvents["BeforeShow"] = "employee_saln_lut_year_Navigator_BeforeShow";
}
//End BindEvents Method

//employee_saln_lut_year_Navigator_BeforeShow @30-77E6B5BA
function employee_saln_lut_year_Navigator_BeforeShow(& $sender)
{
    $employee_saln_lut_year_Navigator_BeforeShow = true;
    $Component = & $sender;
    $Container = & CCGetParentContainer($sender);
    global $employee_saln_lut_year; //Compatibility
//End employee_saln_lut_year_Navigator_BeforeShow

//Hide-Show Component @31-286333C6
    $Parameter1 = $Container->TotalPages;
    $Parameter2 = 2;
    if (((is_array($Parameter1) || strlen($Parameter1)) && (is_array($Parameter2) || strlen($Parameter2))) && 0 >  CCCompareValues($Parameter1, $Parameter2, ccsInteger))
        $Component->Visible = false;
//End Hide-Show Component

//Close employee_saln_lut_year_Navigator_BeforeShow @30-AC00414D
    return $employee_saln_lut_year_Navigator_BeforeShow;
}
//End Close employee_saln_lut_year_Navigator_BeforeShow


