//End Execute Components

//Go to destination page @1-312CD943
if($Redirect)
{
    $CCSEventResult = CCGetEvent($CCSEvents, "BeforeUnload", $MainPage);
    $DBConnection1->close();
    header("Location: " . $Redirect);
    unset($derogatory);
    unset($derogatory1);
    unset($Tpl);
